# ---------------------------------------------------------------------------
# MnemoSong environment variables. Copy to `.env.local` and fill in.
# The app is designed to RUN WITH A SUBSET of these:
#   - Minimum to generate a song for FREE: GEMINI_API_KEY + GOOGLE_APPLICATION_CREDENTIALS
#     (Google TTS) and MUSIC_PROVIDER=google-tts-beat.
#   - For sung output: add FAL_KEY and set MUSIC_PROVIDER=fal-acestep.
#   - Persistence/auth/storage need DATABASE_URL, AUTH_*, and R2_*.
# ---------------------------------------------------------------------------

# Public base URL of the app (used to build webhook callback URLs).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Neon Postgres) ----------------------------------------------
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js (NextAuth v5) + Google OAuth ----------------------------------
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Google Gemini (all text/agent stages; free tier) ----------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Music generation ------------------------------------------------------
# Which MusicProvider to use by default. One of:
#   fal-acestep | fal-minimax | sonauto | google-tts-beat
MUSIC_PROVIDER="fal-acestep"
# Ordered fallback chain (comma-separated). The free path is a good last resort.
MUSIC_FALLBACK_CHAIN="fal-acestep,google-tts-beat"

# fal.ai (ACE-Step / MiniMax / Sonauto). https://fal.ai/dashboard/keys
FAL_KEY=""
# Optional: verify fal webhook authenticity.
FAL_WEBHOOK_SECRET=""

# --- Google Cloud Text-to-Speech (the $0 "rap over a beat" fallback) -------
# Path to a service-account JSON with the Text-to-Speech API enabled.
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Cloudflare R2 (object storage for uploads + generated audio) ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mnemosong"
# Optional public base (custom domain / r2.dev) for public share streaming.
R2_PUBLIC_BASE_URL=""

# --- Inngest (durable pipeline orchestration) ------------------------------
# Local dev uses the Inngest dev server; these are only needed in production.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Tunables (optional; sensible defaults in code) ------------------------
# Max rewrite iterations in the critique→rewrite loop.
PIPELINE_MAX_REWRITES="2"
# Per-user songs/day cap (quota guard).
QUOTA_SONGS_PER_DAY="20"
