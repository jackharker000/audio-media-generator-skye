# ---------------------------------------------------------------------------
# MnemoSong — Google-only stack. Copy to `.env.local` and fill in.
# Everything runs on Google / Firebase free tiers:
#   - Gemini (lyrics + reasoning)        → GEMINI_API_KEY
#   - Firestore (database)               → service account
#   - Cloud Storage (audio/files)        → service account + bucket
#   - Cloud Text-to-Speech (the "music") → service account
# A single Google service account powers Firestore, Storage, and TTS.
# ---------------------------------------------------------------------------

# Public base URL of the app.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (production sign-in). Leave blank locally and use DEV_LOGIN=1.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Local testing without OAuth: set to 1 to enable a one-click demo login.
DEV_LOGIN="1"

# --- Google Gemini (all text/agent stages; free tier) ----------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# ANY env var whose NAME contains "API_KEY" is auto-detected and rotated, so add
# GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... (keys from DIFFERENT Google projects,
# each with its own free quota). Round-robins + fails over when one is limited;
# invalid keys are skipped automatically.
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# (or comma-separated in one var) GEMINI_API_KEYS="key1,key2,key3"
# Optional model override (default: the cheap, higher-quota flash-lite):
# GEMINI_MODEL="gemini-2.5-flash-lite"

# --- Google service account (Firestore + Cloud Storage + Text-to-Speech) ---
# Create a Firebase project (free "Spark" plan), enable Firestore + Storage,
# and the Cloud Text-to-Speech API. Create a service account key (JSON).
#
# On Vercel / serverless: paste the ENTIRE service-account JSON as ONE line:
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Locally you can instead point to the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS="/abs/path/service-account.json"
#
# Optional (derived from the JSON if omitted):
FIREBASE_PROJECT_ID=""

# Audio/file storage:
#   - LEAVE FIREBASE_STORAGE_BUCKET BLANK to store audio/files IN FIRESTORE
#     (no Cloud Storage / Blaze plan needed) — this is the default.
#   - OR set a bucket to use Cloud Storage instead (needs Storage enabled):
#       <project-id>.firebasestorage.app  (or legacy <project-id>.appspot.com)
FIREBASE_STORAGE_BUCKET=""
# Optional explicit override: gcs | firestore | local
# STORAGE_BACKEND=""

# --- Music engine ----------------------------------------------------------
# "gemini-song" (default + fallback): Gemini vocal + pure-JS synth backing. Free.
# "ace-step": open-source model that truly SINGS + full production (see below).
# "gemini-tts": voice only (no backing music).
# "google-tts-beat": Cloud Text-to-Speech over an ffmpeg-mixed beat (needs Cloud billing).
MUSIC_PROVIDER="gemini-song"

# --- ACE-Step (optional; set MUSIC_PROVIDER=ace-step). Falls back to gemini-song. ---
# Pick a backend (auto-detected from what's set, or force with ACESTEP_BACKEND):
# ACESTEP_BACKEND="acemusic"   # acemusic | local | hf
# 1) ACE Music hosted API (free key at https://acemusic.ai/playground/api-key):
# ACEMUSIC_API_KEY=""
# ACEMUSIC_API_URL="https://api.acemusic.ai"
# 2) Self-hosted ACE-Step server (run: python -m acestep.api_server --api-key KEY):
# ACESTEP_LOCAL_URL="http://localhost:8000"
# ACESTEP_LOCAL_API_KEY=""
# 3) Hugging Face Gradio Space (experimental; signature varies per Space):
# ACESTEP_HF_SPACE="ace-step/ACE-Step"
# HF_TOKEN=""
# Optional: pin/override the Gemini TTS model and voices.
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
# GEMINI_TTS_VOICE_FEMALE="Kore"
# GEMINI_TTS_VOICE_MALE="Puck"

# --- Tunables --------------------------------------------------------------
PIPELINE_MAX_REWRITES="1"
QUOTA_SONGS_PER_DAY="20"
